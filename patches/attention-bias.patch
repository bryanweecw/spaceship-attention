+        // Add to the existing mask after causal/sequence/SWA/padding masking.
+        // The graph consumes this as softmax(QK^T / sqrt(d) + mask + bias).
+        if (!spaceship_attention_bias.empty()) {
+            const auto apply_bias = [&](auto * data) {
+                using T = std::remove_reference_t<decltype(*data)>;
+                for (int64_t s = 0; s < n_stream; ++s) {
+                    for (int64_t q = 0; q < n_tps; ++q) {
+                        const auto seq = ubatch->seq_id[s*n_tps + q][0];
+                        const auto & cells = v_cells.at(seq_to_stream[seq]);
+                        for (int64_t k = 0; k < n_kv; ++k) {
+                            const int64_t idx = (s*n_tps + q)*n_kv + k;
+                            const float current = llama_cast<float>(data[idx]);
+                            if (!std::isfinite(current)) continue;
+                            const int32_t cell = rows ? rows[s*n_kv + k] : k;
+                            if (cell < 0 || size_t(cell) >= cells.size()) continue;
+                            const auto pos = cells.pos_get(cell);
+                            if (pos >= 0 && size_t(pos) < spaceship_attention_bias.size()) {
+                                data[idx] = llama_cast<T>(current + spaceship_attention_bias[pos]);
+                            }
+                        }
+                    }
+                }
+            };
+            if (dst->type == GGML_TYPE_F16) apply_bias((ggml_fp16_t *) dst->data);
+            else apply_bias((float *) dst->data);
+        }
