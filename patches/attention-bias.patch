 #include "llama-arch.h"
@@ -4672,6 +4673,17 @@ void llama_set_embeddings(llama_context * ctx, bool embeddings) {
     ctx->set_embeddings(embeddings);
 }
 
+bool llama_set_attention_bias(llama_context * ctx, const float * bias, int32_t n) {
+    if (!ctx || n < 0 || (n && !bias) || uint32_t(n) > ctx->n_ctx()) return false;
+    auto * kv = dynamic_cast<llama_kv_cache *>(ctx->get_memory());
+    if (!kv) return false;
+    for (int32_t i = 0; i < n; ++i) if (!std::isfinite(bias[i]) || std::abs(bias[i]) > 8.0f) return false;
+    ctx->synchronize();
+    kv->spaceship_attention_bias.clear();
+    if (n) kv->spaceship_attention_bias.assign(bias, bias + n);
+    return true;
+}
+
 void llama_set_causal_attn(llama_context * ctx, bool causal_attn) {
     ctx->set_causal_attn(causal_attn);
 }
